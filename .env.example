FLASK_ENV=production
FLASK_DEBUG=false
LEADS_SECRET_KEY=replace-with-a-long-random-secret
LEADS_RAW_DB_PATH=/path/to/leads.db
LEADS_AUTH_DB_PATH=/path/to/leads_auth.db
LEADS_DUCKDB_PATH=/path/to/leads_analytics.db
LEADS_SESSION_LIFETIME_SECONDS=28800
LEADS_SESSION_COOKIE_SAMESITE=Lax
LEADS_SESSION_COOKIE_SECURE=true
LEADS_CORS_ORIGINS=https://www.autosevice.xyz,https://autosevice.xyz
LEADS_DEFAULT_ADMIN_USERNAME=admin
LEADS_DEFAULT_ADMIN_PASSWORD=replace-before-first-production-start
